import Mathlib
import Mistranslation.PairLaw

/-! # The rank-n law (2026-10-23)

One theorem for every clock rank n = k + 2 >= 2. A break carries clocks L_0, ..., L_(k+1). The time and top conditions
are two linear equations in the clocks. Solve them for L_0, L_1; the other k clocks stay free. Then every clock and
every e^(clock) is algebraic over Q(z, L_2, ..., L_(k+1)), a field generated by k + 1 numbers -- one short of the
k + 2 independent clocks. That reduction is proved here with NO hypothesis (C3 rewrite). Whether it can happen is the
open (Schanuel-type) fact, recorded as data and NOT assumed.
Rank 1 is the unconditional law (Recipe.lean); pair and trio are the cases k = 0, 1 (PairLaw.lean). -/

namespace RankLaw

open IntermediateField

/-- The free clocks of a rank-(k+2) family: L_2, ..., L_(k+1). -/
def free {k : ℕ} (L : Fin (k + 2) → ℝ) : Fin k → ℝ := fun j => L ⟨j.1 + 2, by omega⟩

lemma sum_split {k : ℕ} (a L : Fin (k + 2) → ℝ) :
    ∑ i, a i * L i = a 0 * L 0 + a 1 * L 1 + ∑ j : Fin k, a ⟨j.1 + 2, by omega⟩ * L ⟨j.1 + 2, by omega⟩ := by
  rw [Fin.sum_univ_succ, Fin.sum_univ_succ]
  simp only [Fin.succ_zero_eq_one, add_assoc]
  rfl

/-- **The rank-n reduction (unconditional).** An algebraic break forces every clock and every e^(clock) algebraic over
Q(z, free clocks). -/
theorem rank_reduction {k : ℕ} {μ z c d : ℝ} {L a b : Fin (k + 2) → ℝ}
    (h1 : ∑ i, a i * L i = c) (h2 : ∑ i, b i * L i = d) (hdet : a 0 * b 1 - a 1 * b 0 ≠ 0)
    (ha : ∀ i, IsAlgebraic (adjoin ℚ (insert z (Set.range (free L)))) (a i))
    (hb : ∀ i, IsAlgebraic (adjoin ℚ (insert z (Set.range (free L)))) (b i))
    (hd : IsAlgebraic (adjoin ℚ (insert z (Set.range (free L)))) d)
    (hc : IsAlgebraic ℚ μ → IsAlgebraic (adjoin ℚ (insert z (Set.range (free L)))) c)
    (he : ∀ i, IsAlgebraic (adjoin ℚ (insert z (Set.range (free L)))) (Real.exp (L i))) :
    IsAlgebraic ℚ μ → ∀ i, IsAlgebraic (adjoin ℚ (insert z (Set.range (free L)))) (L i) ∧
      IsAlgebraic (adjoin ℚ (insert z (Set.range (free L)))) (Real.exp (L i)) := by
  intro hμ
  set F := adjoin ℚ (insert z (Set.range (free L)))
  have mem : ∀ x : ℝ, IsAlgebraic F x ↔ x ∈ algebraicClosure F ℝ := fun x => mem_algebraicClosure_iff.symm
  have hfree : ∀ j : Fin k, IsAlgebraic F (L ⟨j.1 + 2, by omega⟩) := fun j =>
    isAlgebraic_algebraMap (R := F) (A := ℝ)
      (⟨L ⟨j.1 + 2, by omega⟩, subset_adjoin ℚ _ (Set.mem_insert_of_mem _ ⟨j, rfl⟩)⟩ : F)
  have hsum : ∀ w : Fin (k + 2) → ℝ, (∀ i, IsAlgebraic F (w i)) →
      IsAlgebraic F (∑ j : Fin k, w ⟨j.1 + 2, by omega⟩ * L ⟨j.1 + 2, by omega⟩) := fun w hw => by
    rw [mem]; exact Subalgebra.sum_mem _ fun j _ => (mem _).1 ((hw _).mul (hfree j))
  set R1 := c - ∑ j : Fin k, a ⟨j.1 + 2, by omega⟩ * L ⟨j.1 + 2, by omega⟩
  set R2 := d - ∑ j : Fin k, b ⟨j.1 + 2, by omega⟩ * L ⟨j.1 + 2, by omega⟩
  have e1 : a 0 * L 0 + a 1 * L 1 = R1 := by rw [sum_split] at h1; linarith
  have e2 : b 0 * L 0 + b 1 * L 1 = R2 := by rw [sum_split] at h2; linarith
  have hR1 : IsAlgebraic F R1 := (hc hμ).sub (hsum a ha)
  have hR2 : IsAlgebraic F R2 := hd.sub (hsum b hb)
  have hdetA : IsAlgebraic F (a 0 * b 1 - a 1 * b 0) := ((ha 0).mul (hb 1)).sub ((ha 1).mul (hb 0))
  have hL0 : L 0 = (R1 * b 1 - a 1 * R2) * (a 0 * b 1 - a 1 * b 0)⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq₀ hdet]; linear_combination b 1 * e1 - a 1 * e2
  have hL1 : L 1 = (a 0 * R2 - R1 * b 0) * (a 0 * b 1 - a 1 * b 0)⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq₀ hdet]; linear_combination a 0 * e2 - b 0 * e1
  intro i
  refine ⟨?_, he i⟩
  match i with
  | ⟨0, _⟩ => rw [show (⟨0, _⟩ : Fin (k + 2)) = 0 from rfl, hL0]
              exact ((hR1.mul (hb 1)).sub ((ha 1).mul hR2)).mul hdetA.inv
  | ⟨1, _⟩ => rw [show (⟨1, _⟩ : Fin (k + 2)) = 1 from rfl, hL1]
              exact (((ha 0).mul hR2).sub (hR1.mul (hb 0))).mul hdetA.inv
  | ⟨n + 2, hn⟩ => exact hfree ⟨n, by omega⟩

end RankLaw
